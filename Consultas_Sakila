-- ============================================================
-- 1. Crea el esquema de la BBDD.
-- ============================================================
-- El esquema se crea ejecutando el archivo BBDD_Proyecto_shakila_sinuser.sql
-- Tablas principales del esquema:
--   · Contenido:   actor, film, film_actor, film_category, category, language
--   · Operativas:  inventory, rental, payment
--   · Personas:    customer, staff, store, address, city, country


-- ============================================================
-- 2. Muestra los nombres de todas las películas con clasificación 'R'.
-- ============================================================
-- Análisis: usamos la columna 'rating' que es de tipo enum (G, PG, PG-13, R, NC-17).
-- No hace falta JOIN porque toda la información está en la tabla film.
SELECT title
FROM film
WHERE rating = 'R'
ORDER BY title;


-- ============================================================
-- 3. Encuentra los nombres de los actores con actor_id entre 30 y 40.
-- ============================================================
-- BETWEEN es equivalente a >= 30 AND <= 40, ambos extremos incluidos.
SELECT first_name, last_name, actor_id
FROM actor
WHERE actor_id BETWEEN 30 AND 40
ORDER BY actor_id;


-- ============================================================
-- 4. Obtén las películas cuyo idioma coincide con el idioma original.
-- ============================================================
-- Nota de análisis: en esta versión de Sakila, original_language_id es NULL
-- en todos los registros, por lo que esta consulta no devuelve resultados.
-- La condición NULL = NULL es siempre FALSE en SQL; habría que usar IS NOT DISTINCT FROM.
-- Se deja la consulta correcta según la lógica del enunciado:
SELECT title, language_id, original_language_id
FROM film
WHERE language_id = original_language_id;


-- ============================================================
-- 5. Ordena las películas por duración de forma ascendente.
-- ============================================================
-- 'length' contiene la duración en minutos. ASC es el orden por defecto
-- pero se escribe explícitamente por claridad.
SELECT title, length AS duracion_minutos
FROM film
ORDER BY length ASC;


-- ============================================================
-- 6. Encuentra el nombre y apellido de los actores con apellido 'Allen'.
-- ============================================================
SELECT first_name, last_name
FROM actor
WHERE last_name = 'Allen';


-- ============================================================
-- 7. Cantidad total de películas por clasificación.
-- ============================================================
-- GROUP BY agrupa los registros por cada valor distinto de rating.
-- COUNT(*) cuenta todas las filas de cada grupo.
SELECT rating                   AS clasificacion,
       COUNT(*)                 AS total_peliculas
FROM film
GROUP BY rating
ORDER BY total_peliculas DESC;


-- ============================================================
-- 8. Películas que son 'PG-13' O tienen duración mayor a 3 horas.
-- ============================================================
-- OR evalúa las dos condiciones de forma independiente; un registro aparece
-- si cumple al menos una. 3 horas = 180 minutos.
SELECT title,
       rating,
       length AS duracion_minutos
FROM film
WHERE rating = 'PG-13'
   OR length > 180
ORDER BY length DESC;


-- ============================================================
-- 9. Variabilidad del coste de reemplazo de las películas.
-- ============================================================
-- Usamos VARIANCE() como medida estadística de dispersión.
-- Un valor alto indica que los costes de reemplazo son muy dispares.
SELECT ROUND(VARIANCE(replacement_cost), 4) AS varianza_coste_reemplazo,
       ROUND(STDDEV(replacement_cost), 2)   AS desviacion_estandar,
       MIN(replacement_cost)                AS minimo,
       MAX(replacement_cost)                AS maximo
FROM film;


-- ============================================================
-- 10. Mayor y menor duración de una película.
-- ============================================================
SELECT MAX(length) AS duracion_maxima_min,
       MIN(length) AS duracion_minima_min
FROM film;


-- ============================================================
-- 11. Lo que costó el antepenúltimo alquiler ordenado por día.
-- ============================================================
-- Ordenamos descendente por fecha (el más reciente primero),
-- saltamos los 2 primeros con OFFSET 2 y cogemos el siguiente (LIMIT 1).
-- OFFSET 0 = último, OFFSET 1 = penúltimo, OFFSET 2 = antepenúltimo.
SELECT r.rental_id,
       r.rental_date,
       p.amount AS coste
FROM rental r
JOIN payment p ON r.rental_id = p.rental_id
ORDER BY r.rental_date DESC
OFFSET 2
LIMIT 1;


-- ============================================================
-- 12. Películas que no son 'NC-17' ni 'G'.
-- ============================================================
-- NOT IN excluye todos los valores de la lista.
-- Alternativa equivalente: WHERE rating != 'NC-17' AND rating != 'G'
SELECT title, rating
FROM film
WHERE rating NOT IN ('NC-17', 'G')
ORDER BY rating, title;


-- ============================================================
-- 13. Promedio de duración de películas por clasificación.
-- ============================================================
-- ROUND(..., 2) limita a 2 decimales para mayor legibilidad.
SELECT rating                        AS clasificacion,
       ROUND(AVG(length), 2)         AS promedio_duracion_min,
       COUNT(*)                      AS total_peliculas
FROM film
GROUP BY rating
ORDER BY promedio_duracion_min DESC;


-- ============================================================
-- 14. Películas con duración mayor a 180 minutos.
-- ============================================================
SELECT title, length AS duracion_minutos
FROM film
WHERE length > 180
ORDER BY length DESC;


-- ============================================================
-- 15. ¿Cuánto dinero ha generado en total la empresa?
-- ============================================================
-- SUM sobre la columna amount de la tabla payment, que registra cada cobro.
SELECT SUM(amount) AS ingresos_totales
FROM payment;


-- ============================================================
-- 16. Los 10 clientes con mayor valor de id.
-- ============================================================
-- Mayor valor de id implica los registros más recientes (IDs más altos).
SELECT customer_id, first_name, last_name
FROM customer
ORDER BY customer_id DESC
LIMIT 10;


-- ============================================================
-- 17. Actores que aparecen en la película 'Egg Igby'.
-- ============================================================
-- Necesitamos unir actor → film_actor → film.
-- film_actor es la tabla intermedia de la relación N:M entre actor y film.
SELECT a.first_name, a.last_name
FROM actor a
JOIN film_actor fa ON a.actor_id = fa.actor_id
JOIN film f        ON fa.film_id = f.film_id
WHERE f.title = 'Egg Igby';


-- ============================================================
-- 18. Todos los nombres de películas únicos.
-- ============================================================
-- DISTINCT elimina duplicados. En Sakila todos los títulos son únicos,
-- pero la cláusula es correcta para garantizarlo.
SELECT DISTINCT title
FROM film
ORDER BY title;


-- ============================================================
-- 19. Comedias con duración mayor a 180 minutos.
-- ============================================================
-- La categoría de cada película se obtiene via film_category y category.
SELECT f.title, f.length AS duracion_minutos
FROM film f
JOIN film_category fc ON f.film_id = fc.film_id
JOIN category c       ON fc.category_id = c.category_id
WHERE c.name = 'Comedy'
  AND f.length > 180
ORDER BY f.length DESC;


-- ============================================================
-- 20. Categorías con promedio de duración superior a 110 minutos.
-- ============================================================
-- HAVING filtra DESPUÉS de agrupar (equivale a un WHERE sobre el resultado del GROUP BY).
SELECT c.name                   AS categoria,
       ROUND(AVG(f.length), 2)  AS promedio_duracion_min,
       COUNT(f.film_id)         AS total_peliculas
FROM category c
JOIN film_category fc ON c.category_id = fc.category_id
JOIN film f           ON fc.film_id = f.film_id
GROUP BY c.name
HAVING AVG(f.length) > 110
ORDER BY promedio_duracion_min DESC;


-- ============================================================
-- 21. ¿Cuál es la media de duración del alquiler de las películas?
-- ============================================================
-- rental_duration es el número de días pactados en el contrato de alquiler.
-- (No confundir con la duración real del alquiler, que sería return_date - rental_date.)
SELECT ROUND(AVG(rental_duration), 2) AS media_dias_alquiler_pactados
FROM film;


-- ============================================================
-- 22. Columna con nombre y apellido completos de todos los actores.
-- ============================================================
-- Concatenamos first_name y last_name con un espacio intermedio.
SELECT first_name || ' ' || last_name AS nombre_completo
FROM actor
ORDER BY last_name, first_name;


-- ============================================================
-- 23. Número de alquileres por día, ordenados descendentemente.
-- ============================================================
-- DATE() extrae solo la parte de fecha del timestamp.
SELECT DATE(rental_date)   AS dia,
       COUNT(*)            AS num_alquileres
FROM rental
GROUP BY DATE(rental_date)
ORDER BY num_alquileres DESC;


-- ============================================================
-- 24. Películas con duración superior al promedio.
-- ============================================================
-- Subconsulta escalar en WHERE: primero se calcula el promedio global,
-- luego se filtra. Más eficiente que calcular el promedio por cada fila.
SELECT title,
       length AS duracion_minutos
FROM film
WHERE length > (
    SELECT AVG(length)
    FROM film
)
ORDER BY length DESC;


-- ============================================================
-- 25. Número de alquileres registrados por mes.
-- ============================================================
-- TO_CHAR formatea el timestamp como 'YYYY-MM' para agrupar por mes.
SELECT TO_CHAR(rental_date, 'YYYY-MM') AS mes,
       COUNT(*)                        AS num_alquileres
FROM rental
GROUP BY TO_CHAR(rental_date, 'YYYY-MM')
ORDER BY mes;


-- ============================================================
-- 26. Promedio, desviación estándar y varianza del total pagado.
-- ============================================================
SELECT ROUND(AVG(amount), 2)      AS promedio,
       ROUND(STDDEV(amount), 4)   AS desviacion_estandar,
       ROUND(VARIANCE(amount), 4) AS varianza
FROM payment;


-- ============================================================
-- 27. Películas que se alquilan por encima del precio medio.
-- ============================================================
-- Subconsulta escalar que calcula el precio medio de alquiler
-- y lo compara con cada fila de la tabla.
SELECT title,
       rental_rate AS precio_alquiler
FROM film
WHERE rental_rate > (
    SELECT AVG(rental_rate)
    FROM film
)
ORDER BY rental_rate DESC, title;


-- ============================================================
-- 28. Actores que han participado en más de 40 películas.
-- ============================================================
-- HAVING COUNT(*) > 40 filtra los grupos (actores) con más de 40 films.
SELECT actor_id,
       COUNT(*) AS num_peliculas
FROM film_actor
GROUP BY actor_id
HAVING COUNT(*) > 40
ORDER BY num_peliculas DESC;


-- ============================================================
-- 29. Todas las películas y su cantidad disponible en inventario.
-- ============================================================
-- LEFT JOIN para incluir también películas sin copias en inventario.
-- El inventario contiene una fila por cada copia física de la película.
SELECT f.title,
       COUNT(i.inventory_id) AS copias_en_inventario
FROM film f
LEFT JOIN inventory i ON f.film_id = i.film_id
GROUP BY f.film_id, f.title
ORDER BY copias_en_inventario DESC, f.title;


-- ============================================================
-- 30. Actores y el número de películas en las que han actuado.
-- ============================================================
SELECT a.first_name,
       a.last_name,
       COUNT(fa.film_id) AS num_peliculas
FROM actor a
JOIN film_actor fa ON a.actor_id = fa.actor_id
GROUP BY a.actor_id, a.first_name, a.last_name
ORDER BY num_peliculas DESC;


-- ============================================================
-- 31. Todas las películas con los actores que han actuado en ellas
--     (incluso películas sin actores).
-- ============================================================
-- LEFT JOIN desde film garantiza que aparecen todas las películas,
-- aunque no tengan actores asignados en film_actor.
SELECT f.title,
       a.first_name,
       a.last_name
FROM film f
LEFT JOIN film_actor fa ON f.film_id = fa.film_id
LEFT JOIN actor a       ON fa.actor_id = a.actor_id
ORDER BY f.title, a.last_name;


-- ============================================================
-- 32. Todos los actores con las películas en las que han actuado
--     (incluso actores sin películas).
-- ============================================================
-- LEFT JOIN desde actor: todos los actores aparecen aunque no tengan
-- ninguna película en film_actor (el opuesto de la consulta 31).
SELECT a.first_name,
       a.last_name,
       f.title
FROM actor a
LEFT JOIN film_actor fa ON a.actor_id = fa.actor_id
LEFT JOIN film f        ON fa.film_id = f.film_id
ORDER BY a.last_name, a.first_name;


-- ============================================================
-- 33. Todas las películas y todos los registros de alquiler.
-- ============================================================
-- FULL OUTER JOIN combina LEFT y RIGHT JOIN: aparecen todas las filas
-- de ambas tablas aunque no tengan correspondencia. Útil para auditorías.
SELECT f.title,
       r.rental_id,
       r.rental_date
FROM film f
FULL OUTER JOIN inventory i ON f.film_id = i.film_id
FULL OUTER JOIN rental r    ON i.inventory_id = r.inventory_id
ORDER BY f.title NULLS LAST, r.rental_date;


-- ============================================================
-- 34. Los 5 clientes que más dinero se han gastado.
-- ============================================================
-- Subconsulta para obtener el ranking: unimos pagos con clientes,
-- sumamos por cliente y tomamos los 5 primeros.
SELECT c.customer_id,
       c.first_name,
       c.last_name,
       total.total_gastado
FROM customer c
JOIN (
    SELECT customer_id,
           SUM(amount) AS total_gastado
    FROM payment
    GROUP BY customer_id
    ORDER BY total_gastado DESC
    LIMIT 5
) AS total ON c.customer_id = total.customer_id
ORDER BY total.total_gastado DESC;


