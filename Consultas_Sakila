-- ============================================================
-- 41. Actores agrupados por nombre. ¿Cuál es el más repetido?
-- ============================================================
-- GROUP BY first_name agrupa todos los actores con el mismo nombre.
-- LIMIT 1 devuelve solo el más frecuente.
SELECT first_name              AS nombre,
       COUNT(*)                AS num_actores
FROM actor
GROUP BY first_name
ORDER BY num_actores DESC
LIMIT 1;


-- ============================================================
-- 42. Todos los alquileres y los nombres de los clientes.
-- ============================================================
-- INNER JOIN: solo aparecen alquileres que tienen cliente asociado.
SELECT r.rental_id,
       r.rental_date,
       c.first_name,
       c.last_name
FROM rental r
JOIN customer c ON r.customer_id = c.customer_id
ORDER BY r.rental_date DESC;


-- ============================================================
-- 43. Todos los clientes y sus alquileres si existen
--     (incluidos clientes sin alquileres).
-- ============================================================
-- LEFT JOIN desde customer garantiza que aparecen todos los clientes,
-- aunque no tengan registros en rental. Las columnas de rental serán NULL.
SELECT c.customer_id,
       c.first_name,
       c.last_name,
       r.rental_id,
       r.rental_date
FROM customer c
LEFT JOIN rental r ON c.customer_id = r.customer_id
ORDER BY c.customer_id, r.rental_date;


-- ============================================================
-- 44. CROSS JOIN entre film y category.
-- ============================================================
SELECT f.title, c.name AS categoria
FROM film f
CROSS JOIN category c
ORDER BY f.title, c.name;

-- Respuesta: NO aporta valor práctico.
-- Un CROSS JOIN genera el producto cartesiano: cada película se combina
-- con CADA categoría (1000 películas × 16 categorías = 16.000 filas).
-- Las combinaciones no tienen ninguna relación real entre sí; no indica
-- que cada película pertenezca a cada categoría. Para obtener las categorías
-- reales de cada película, se debe usar JOIN a través de film_category.


-- ============================================================
-- 45. Actores que han participado en películas de la categoría 'Action'.
-- ============================================================
SELECT DISTINCT a.first_name, a.last_name
FROM actor a
JOIN film_actor fa    ON a.actor_id = fa.actor_id
JOIN film_category fc ON fa.film_id = fc.film_id
JOIN category c       ON fc.category_id = c.category_id
WHERE c.name = 'Action'
ORDER BY a.last_name, a.first_name;


-- ============================================================
-- 46. Actores que NO han participado en ninguna película.
-- ============================================================
-- LEFT JOIN + IS NULL es el patrón estándar para "registros sin correspondencia".
-- Los actores sin filas en film_actor tendrán film_id = NULL.
SELECT a.actor_id,
       a.first_name,
       a.last_name
FROM actor a
LEFT JOIN film_actor fa ON a.actor_id = fa.actor_id
WHERE fa.film_id IS NULL;


-- ============================================================
-- 47. Nombre de los actores y cantidad de películas en las que han participado.
-- ============================================================
SELECT a.first_name,
       a.last_name,
       COUNT(fa.film_id) AS num_peliculas
FROM actor a
LEFT JOIN film_actor fa ON a.actor_id = fa.actor_id
GROUP BY a.actor_id, a.first_name, a.last_name
ORDER BY num_peliculas DESC;


-- ============================================================
-- 48. Crea una vista "actor_num_peliculas".
-- ============================================================
-- Una vista es una consulta guardada que se comporta como una tabla virtual.
-- Ventaja: podemos reutilizarla en otras consultas sin repetir el código.
CREATE OR REPLACE VIEW actor_num_peliculas AS
SELECT a.actor_id,
       a.first_name,
       a.last_name,
       COUNT(fa.film_id) AS num_peliculas
FROM actor a
LEFT JOIN film_actor fa ON a.actor_id = fa.actor_id
GROUP BY a.actor_id, a.first_name, a.last_name;

-- Consultar la vista (como si fuera una tabla):
SELECT * FROM actor_num_peliculas
ORDER BY num_peliculas DESC;


-- ============================================================
-- 49. Número total de alquileres realizados por cada cliente.
-- ============================================================
SELECT c.customer_id,
       c.first_name,
       c.last_name,
       COUNT(r.rental_id) AS total_alquileres
FROM customer c
LEFT JOIN rental r ON c.customer_id = r.customer_id
GROUP BY c.customer_id, c.first_name, c.last_name
ORDER BY total_alquileres DESC;


-- ============================================================
-- 50. Duración total de las películas en la categoría 'Action'.
-- ============================================================
SELECT SUM(f.length) AS duracion_total_minutos,
       COUNT(f.film_id) AS total_peliculas
FROM film f
JOIN film_category fc ON f.film_id = fc.film_id
JOIN category c       ON fc.category_id = c.category_id
WHERE c.name = 'Action';


-- ============================================================
-- 51. Tabla temporal "cliente_rentas_temporal".
-- ============================================================
-- CREATE TEMP TABLE solo existe durante la sesión actual de la conexión.
-- Es útil para almacenar resultados intermedios en consultas complejas.
CREATE TEMP TABLE cliente_rentas_temporal AS
SELECT c.customer_id,
       c.first_name,
       c.last_name,
       COUNT(r.rental_id) AS total_alquileres
FROM customer c
LEFT JOIN rental r ON c.customer_id = r.customer_id
GROUP BY c.customer_id, c.first_name, c.last_name;

-- Consultar la tabla temporal:
SELECT * FROM cliente_rentas_temporal
ORDER BY total_alquileres DESC;


-- ============================================================
-- 52. Tabla temporal "peliculas_alquiladas" (alquiladas >= 10 veces).
-- ============================================================
CREATE TEMP TABLE peliculas_alquiladas AS
SELECT f.film_id,
       f.title,
       COUNT(r.rental_id) AS num_alquileres
FROM film f
JOIN inventory i ON f.film_id = i.film_id
JOIN rental r    ON i.inventory_id = r.inventory_id
GROUP BY f.film_id, f.title
HAVING COUNT(r.rental_id) >= 10;

-- Consultar la tabla temporal:
SELECT * FROM peliculas_alquiladas
ORDER BY num_alquileres DESC;


-- ============================================================
-- 53. Películas alquiladas por 'Tammy Sanders' que aún no se han devuelto.
-- ============================================================
-- return_date IS NULL indica que la película no ha sido devuelta todavía.
SELECT f.title
FROM film f
JOIN inventory i ON f.film_id = i.film_id
JOIN rental r    ON i.inventory_id = r.inventory_id
JOIN customer c  ON r.customer_id = c.customer_id
WHERE c.first_name = 'Tammy'
  AND c.last_name  = 'Sanders'
  AND r.return_date IS NULL
ORDER BY f.title ASC;


-- ============================================================
-- 54. Actores que han actuado en al menos una película de 'Sci-Fi'.
--     Ordenados por apellido.
-- ============================================================
SELECT DISTINCT a.first_name, a.last_name
FROM actor a
JOIN film_actor fa    ON a.actor_id = fa.actor_id
JOIN film_category fc ON fa.film_id = fc.film_id
JOIN category c       ON fc.category_id = c.category_id
WHERE c.name = 'Sci-Fi'
ORDER BY a.last_name ASC;


-- ============================================================
-- 55. Actores que han actuado en películas alquiladas después del
--     primer alquiler de 'Spartacus Cheaper'.
-- ============================================================
-- Subconsulta para obtener la fecha del primer alquiler de esa película.
-- El resultado se usa como umbral en el filtro del WHERE principal.
SELECT DISTINCT a.first_name, a.last_name
FROM actor a
JOIN film_actor fa ON a.actor_id = fa.actor_id
JOIN inventory i   ON fa.film_id = i.film_id
JOIN rental r      ON i.inventory_id = r.inventory_id
WHERE r.rental_date > (
    -- Subconsulta: primer alquiler de 'Spartacus Cheaper'
    SELECT MIN(r2.rental_date)
    FROM rental r2
    JOIN inventory i2 ON r2.inventory_id = i2.inventory_id
    JOIN film f2      ON i2.film_id = f2.film_id
    WHERE f2.title = 'Spartacus Cheaper'
)
ORDER BY a.last_name ASC;


-- ============================================================
-- 56. Actores que NO han actuado en ninguna película de 'Music'.
-- ============================================================
-- NOT IN con subconsulta: primero obtenemos todos los actores de
-- películas 'Music', luego excluimos esos actor_id del resultado final.
SELECT a.first_name, a.last_name
FROM actor a
WHERE a.actor_id NOT IN (
    -- Subconsulta: actor_ids que SÍ han participado en 'Music'
    SELECT DISTINCT fa.actor_id
    FROM film_actor fa
    JOIN film_category fc ON fa.film_id = fc.film_id
    JOIN category c       ON fc.category_id = c.category_id
    WHERE c.name = 'Music'
)
ORDER BY a.last_name, a.first_name;


-- ============================================================
-- 57. Películas alquiladas por más de 8 días.
-- ============================================================
-- La duración real del alquiler es return_date - rental_date.
-- Se excluyen los alquileres sin devolver (return_date IS NULL).
SELECT DISTINCT f.title
FROM film f
JOIN inventory i ON f.film_id = i.film_id
JOIN rental r    ON i.inventory_id = r.inventory_id
WHERE r.return_date IS NOT NULL
  AND (r.return_date - r.rental_date) > INTERVAL '8 days'
ORDER BY f.title;


-- ============================================================
-- 58. Películas de la misma categoría que 'Animation'.
-- ============================================================
-- Subconsulta para obtener el category_id de 'Animation' y
-- usarlo como filtro en la consulta principal.
SELECT f.title
FROM film f
JOIN film_category fc ON f.film_id = fc.film_id
WHERE fc.category_id = (
    -- Subconsulta: category_id de 'Animation'
    SELECT category_id
    FROM category
    WHERE name = 'Animation'
)
ORDER BY f.title;


-- ============================================================
-- 59. Películas con la misma duración que 'Dancing Fever'.
-- ============================================================
-- Subconsulta escalar: devuelve un único valor (la duración de esa película)
-- para compararlo con el resto.
SELECT title, length AS duracion_minutos
FROM film
WHERE length = (
    -- Subconsulta: duración de 'Dancing Fever'
    SELECT length
    FROM film
    WHERE title = 'Dancing Fever'
)
  AND title != 'Dancing Fever'   -- excluimos la propia película
ORDER BY title ASC;


-- ============================================================
-- 60. Clientes que han alquilado al menos 7 películas distintas.
-- ============================================================
-- COUNT(DISTINCT i.film_id) cuenta películas únicas (no copias repetidas).
SELECT c.first_name,
       c.last_name,
       COUNT(DISTINCT i.film_id) AS peliculas_distintas
FROM customer c
JOIN rental r    ON c.customer_id = r.customer_id
JOIN inventory i ON r.inventory_id = i.inventory_id
GROUP BY c.customer_id, c.first_name, c.last_name
HAVING COUNT(DISTINCT i.film_id) >= 7
ORDER BY c.last_name ASC;


-- ============================================================
-- 61. Cantidad total de películas alquiladas por categoría.
-- ============================================================
SELECT c.name          AS categoria,
       COUNT(r.rental_id) AS total_alquileres
FROM category c
JOIN film_category fc ON c.category_id = fc.category_id
JOIN inventory i      ON fc.film_id = i.film_id
JOIN rental r         ON i.inventory_id = r.inventory_id
GROUP BY c.name
ORDER BY total_alquileres DESC;


-- ============================================================
-- 62. Número de películas por categoría estrenadas en 2006.
-- ============================================================
-- El campo release_year es de tipo DOMAIN (basado en integer),
-- por lo que se puede comparar directamente con = 2006.
SELECT c.name        AS categoria,
       COUNT(f.film_id) AS num_peliculas_2006
FROM category c
JOIN film_category fc ON c.category_id = fc.category_id
JOIN film f           ON fc.film_id = f.film_id
WHERE f.release_year = 2006
GROUP BY c.name
ORDER BY num_peliculas_2006 DESC;


-- ============================================================
-- 63. Todas las combinaciones posibles de trabajadores con tiendas.
-- ============================================================
-- CROSS JOIN entre staff y store: genera todas las asignaciones posibles,
-- útil para ver qué combinaciones trabajador-tienda existen o no existen.
SELECT s.staff_id,
       s.first_name || ' ' || s.last_name AS nombre_empleado,
       st.store_id
FROM staff s
CROSS JOIN store st
ORDER BY s.staff_id, st.store_id;


-- ============================================================
-- 64. Cantidad total de películas alquiladas por cada cliente.
-- ============================================================
SELECT c.customer_id,
       c.first_name,
       c.last_name,
       COUNT(r.rental_id) AS total_alquileres
FROM customer c
LEFT JOIN rental r ON c.customer_id = r.customer_id
GROUP BY c.customer_id, c.first_name, c.last_name
ORDER BY total_alquileres DESC;
